# Patch: Use liger swiglu functions in SwiGLUFunction 
#
# Problem:
# - The default SwiGLU implementation relies on the JIT fuser, which may produce suboptimal
# kernels compared to hand-tuned Triton implementations.
#
# What this patch does:
# - It uses the swiglu_forward and swiglu_backward functions int the SwiGLUFunction to try and improve the
# throughput.
diff --git a/megatron/core/fusions/fused_bias_swiglu.py b/megatron/core/fusions/fused_bias_swiglu.py
index 632470876..29e505c02 100644
--- a/megatron/core/fusions/fused_bias_swiglu.py
+++ b/megatron/core/fusions/fused_bias_swiglu.py
@@ -9,6 +9,9 @@ import torch.nn.functional as F
 from megatron.core.jit import jit_fuser
 from megatron.core.utils import nvtx_decorator
 
+from liger_kernel.ops.swiglu import swiglu_forward
+from liger_kernel.ops.swiglu import swiglu_backward
+
 ###### BIAS SWIGLU FUSION/ NO AUTOGRAD ################
 
 
@@ -145,47 +148,33 @@ class BiasSwiGLUFunction(torch.autograd.Function):
 
 
 class SwiGLUFunction(torch.autograd.Function):
-    """Custom autograd function for SwiGLU activation without bias."""
+    """Custom autograd function for SwiGLU activation without bias.
+
+    Uses Liger Kernel's fused Triton implementation.
+    """
 
     @staticmethod
     @nvtx_decorator()
     def forward(ctx, input, fp8_input_store, cpu_offload_input):
-        """Forward pass of SwiGLU activation.
-
-        Args:
-            ctx: Autograd context object for saving tensors for backward pass.
-            input (torch.Tensor): Input tensor to apply SwiGLU to.
-            fp8_input_store (bool): If True, stores intermediate values in FP8 format.
-
-        Returns:
-            torch.Tensor: Result of applying SwiGLU activation.
-        """
         input_for_backward = input.to(torch.float8_e4m3fn) if fp8_input_store else input
         if cpu_offload_input:
             input_for_backward.activation_offloading = True
         ctx.save_for_backward(input_for_backward)
         ctx.ori_input_dtype = input.dtype
         ctx.fp8_input_store = fp8_input_store
-        return swiglu(input)
+
+        y_1, y_2 = torch.chunk(input, 2, -1)
+        return swiglu_forward(y_1.contiguous(), y_2.contiguous())[2]
 
     @staticmethod
     @nvtx_decorator()
     def backward(ctx, grad_output):
-        """Backward pass of SwiGLU activation.
-
-        Args:
-            ctx: Autograd context object containing saved tensors from forward pass.
-            grad_output (torch.Tensor): Gradient of the loss with respect to the output.
-
-        Returns:
-            tuple: Tuple containing:
-                - Gradient with respect to the input tensor
-                - None for fp8_input_store parameter
-        """
         input = ctx.saved_tensors[0]
         input = input.to(ctx.ori_input_dtype) if ctx.fp8_input_store else input
-        tmp = swiglu_back(grad_output, input)
-        return tmp, None, None
+
+        y_1, y_2 = torch.chunk(input, 2, -1)
+        da, db = swiglu_backward(y_1.contiguous(), y_2.contiguous(), grad_output.contiguous())
+        return torch.cat([da, db], dim=-1), None, None
 
 
 class WeightedSwiGLUFunction(torch.autograd.Function):
