# Patch: Use LigerRMSNorm in WrappedTorchNorm
#
# Problem:
# - The default RMSNorm implementation relies on PyTorch's built-in kernel, which may be
# suboptimal compared to a hand-tuned Triton implementation.
#
# What this patch does:
# - It replaces torch.nn.RMSNorm with LigerRMSNorm in WrappedTorchNorm to try and improve the
# throughput. Also removes the PyTorch >= 2.4.0 version assertion that is no longer needed.
diff --git a/megatron/core/transformer/torch_norm.py b/megatron/core/transformer/torch_norm.py
index d0ceca7af..1c686a2b2 100644
--- a/megatron/core/transformer/torch_norm.py
+++ b/megatron/core/transformer/torch_norm.py
@@ -5,6 +5,8 @@ from megatron.core.jit import jit_fuser
 from megatron.core.transformer import TransformerConfig
 from megatron.core.utils import is_torch_min_version
 
+from liger_kernel.transformers.rms_norm import LigerRMSNorm
+
 
 class WrappedTorchNorm:
     """
@@ -38,11 +40,7 @@ class WrappedTorchNorm:
         if config.normalization == "LayerNorm":
             norm_cls = torch.nn.LayerNorm
         elif config.normalization == "RMSNorm":
-            assert is_torch_min_version(
-                "2.4.0a0"
-            ), 'Torch RMSNorm requires PyTorch version >= 2.4.0'
-
-            norm_cls = torch.nn.RMSNorm
+            return LigerRMSNorm(hidden_size, eps=eps, casting_mode="none")
         elif config.normalization == "L2Norm":
             norm_cls = torch.nn.L2Norm
         else:
